{
  "name": "workspace-font",
  "version": "1.0.0",
  "description": "Sidebar typography for DeepSeek Harness: bold project rows, smaller session rows, per-row font settings, and a Collapse all control.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yadi206/workspace-font.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "typography"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "docs", "icon.svg", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
